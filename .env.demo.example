# Konfigurasi demo lewat tunnel HTTPS (lihat README, bagian Demo lewat tunnel).
# Salin menjadi .env, isi APP_KEY, DB_PASSWORD, dan kunci Midtrans sandbox, lalu ganti nama-domain.
APP_NAME="Kopi & Kita"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://nama-domain.ngrok-free.app

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kopi_kita
DB_USERNAME=kopi_kita
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Aset frontend: true memakai CDN (jsDelivr, code.jquery.com), false memakai salinan di public/vendor
ASSET_CDN=true

# Midtrans Snap sandbox. Isi kunci hanya di .env, jangan di-commit.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
# URL publik tunnel untuk notifikasi, contoh https://nama.ngrok-free.app/midtrans/notification
MIDTRANS_NOTIFICATION_URL=https://nama-domain.ngrok-free.app/midtrans/notification
